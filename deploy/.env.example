# PeaWork HRMS v2 — production environment template.
# Copy to deploy/.env (or /etc/peawork/peawork.env) and replace every value.

PEAWORK_ENV=production
PEAWORK_DEBUG=false
PEAWORK_BASE_URL=https://hr.example.com
PEAWORK_ALLOWED_HOSTS=hr.example.com
PEAWORK_BEHIND_PROXY=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PEAWORK_SECRET_KEY=replace-with-at-least-32-random-characters

# PostgreSQL 16. Keep credentials out of source control.
# Use a URL-safe password, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))".
# Compose builds PEAWORK_DATABASE_URL from POSTGRES_* below, so avoid raw @ : / # ? characters.
PEAWORK_DATABASE_URL=postgresql+psycopg://peawork:replace-db-password@db:5432/peawork

# First-boot organisation and administrator. Change the password before launch.
PEAWORK_ORGANIZATION_NAME=Acme India Pvt Ltd
PEAWORK_ORGANIZATION_COUNTRY=IN
PEAWORK_ORGANIZATION_TIMEZONE=Asia/Kolkata
PEAWORK_ORGANIZATION_CURRENCY=INR
PEAWORK_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PEAWORK_BOOTSTRAP_ADMIN_NAME=Platform Administrator
PEAWORK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password
PEAWORK_SEED_DEMO_DATA=false

# Private document storage. Mount a persistent volume here.
PEAWORK_STORAGE_DIR=/var/lib/peawork/documents
PEAWORK_MAX_UPLOAD_BYTES=10485760

# Sessions
PEAWORK_SESSION_TTL_HOURS=12
PEAWORK_SESSION_IDLE_MINUTES=120
PEAWORK_COOKIE_SECURE=true

# Observability. Set a token to protect /metrics, or leave blank for network-only access.
PEAWORK_METRICS_TOKEN=replace-with-a-long-random-token
PEAWORK_LOG_LEVEL=INFO

# Compose convenience (not read by the application).
POSTGRES_DB=peawork
POSTGRES_USER=peawork
# URL-safe value; Compose interpolates this directly into PEAWORK_DATABASE_URL.
POSTGRES_PASSWORD=replace-db-password
PEAWORK_DOMAIN=hr.example.com
